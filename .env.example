# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configuración obligatoria de Microsoft SQL Server local
# Opción 1 (LocalDB con Autenticación de Windows - ej. (localdb)\MSSQLLocalDB):
#   MSSQL_SERVER="(localdb)\MSSQLLocalDB"
#   MSSQL_DATABASE="SGN_Negocios"
#   MSSQL_TRUSTED_CONNECTION="true"
#   (Requiere en Windows: npm install msnodesqlv8)
#
# Opción 2 (SQL Server / Express con usuario y contraseña SQL):
MSSQL_SERVER="localhost"
MSSQL_PORT="1433"
MSSQL_INSTANCE=""
MSSQL_DATABASE="SGN_Negocios"
MSSQL_USER=""
MSSQL_PASSWORD=""
MSSQL_TRUSTED_CONNECTION="false"
MSSQL_ODBC_DRIVER=""
MSSQL_ENCRYPT="false"
MSSQL_TRUST_SERVER_CERTIFICATE="true"

